# The Lenny Growth Assistant - Environment Variables Example

# Database Connection (Default is for the local Docker pgvector instance)
DATABASE_URL=postgresql://lenny:password@db:5432/lenny_db

# Local LLM Configuration (Default is for host Ollama from within Docker)
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Cloud LLM Configuration
# Set LLM_PROVIDER to 'ollama', 'anthropic', or 'gemini'
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# GEMINI_API_KEY=your_gemini_api_key_here

# Directory containing the transcripts (Default is for the Docker mounted volume)
TRANSCRIPTS_DIR=/data/lenny-transcripts/episodes

# Frontend API URL (Used by Next.js to call FastAPI)
NEXT_PUBLIC_API_URL=http://localhost:8000
